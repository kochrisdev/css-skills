{
  "schema_version": "1.0",
  "name": "agent-platform",
  "mode": "plan-only",
  "description": "Bounded agent design and explicitly evidenced sandbox verification.",
  "inputs": {
    "request": "request",
    "constraints": "constraints",
    "architecture": "architecture",
    "dataset": "dataset"
  },
  "steps": [
    {
      "id": "step-01",
      "skill": "analyzing-requirements",
      "after": [],
      "bindings": {
        "request": "input:request",
        "constraints": "input:constraints"
      },
      "produces": {
        "step-01.requirements": "requirements"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-02",
      "skill": "designing-agents",
      "after": [
        "step-01"
      ],
      "bindings": {
        "requirements": "step-01.requirements"
      },
      "produces": {
        "step-02.agent-design": "agent-design"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-03",
      "skill": "designing-agent-tools",
      "after": [
        "step-02"
      ],
      "bindings": {
        "agent-design": "step-02.agent-design"
      },
      "produces": {
        "step-03.tool-contracts": "tool-contracts"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-04",
      "skill": "threat-modeling",
      "after": [
        "step-03"
      ],
      "bindings": {
        "architecture": "input:architecture",
        "requirements": "step-01.requirements"
      },
      "produces": {
        "step-04.threat-model": "threat-model"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-05",
      "skill": "designing-agent-guardrails",
      "after": [
        "step-04"
      ],
      "bindings": {
        "agent-design": "step-02.agent-design",
        "threat-model": "step-04.threat-model"
      },
      "produces": {
        "step-05.guardrail-design": "guardrail-design"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-06",
      "skill": "evaluating-llms",
      "after": [
        "step-05"
      ],
      "bindings": {
        "agent-design": "step-02.agent-design",
        "dataset": "input:dataset"
      },
      "produces": {
        "step-06.evaluation-plan": "evaluation-plan"
      },
      "approval": "human-supervised"
    },
    {
      "id": "step-07",
      "skill": "testing-agents",
      "after": [
        "step-06"
      ],
      "bindings": {
        "agent-design": "step-02.agent-design",
        "evaluation-plan": "step-06.evaluation-plan"
      },
      "produces": {
        "step-07.agent-verification": "agent-verification"
      },
      "approval": "human-supervised"
    }
  ],
  "stop_conditions": [
    "Missing or contradictory required evidence",
    "Failed mandatory check",
    "Unapproved consequential action"
  ],
  "rework": "Create a new reviewed plan revision; no automatic loops."
}
